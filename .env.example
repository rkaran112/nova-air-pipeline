# Copy this file to .env and fill in the value. Never commit .env.
#
# NOVA_PII_KEY is the secret used to turn personal data (passenger ID, PNR,
# email, phone) into tokens with HMAC-SHA256. Without it the pipeline stops.
# Make your own random key with:
#   python -c "import secrets; print(secrets.token_hex(32))"
NOVA_PII_KEY=

# Optional: the MySQL and MongoDB source systems (see docs/SOURCES.md). The password is
# the one you chose when you created the nova_etl user in MySQL; there is no default.
# NOVA_MYSQL_HOST=127.0.0.1
# NOVA_MYSQL_PORT=3306
# NOVA_MYSQL_USER=nova_etl
NOVA_MYSQL_PASSWORD=
# NOVA_MYSQL_DATABASE=nova_source
# NOVA_MONGO_URI=mongodb://127.0.0.1:27017
# NOVA_MONGO_DATABASE=nova_source
